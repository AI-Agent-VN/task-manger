DEBUG=1
SECRET_KEY="plane-local-secret-key-change-me"

# CORS / hosts
ALLOWED_HOSTS="*"
CORS_ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost,http://127.0.0.1"

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="postgres"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_URL="redis://redis:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# Storage Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://minio:9000"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600
USE_MINIO=1
MINIO_ENDPOINT_SSL=0

# Public base URLs behind the Docker proxy
WEB_URL="http://localhost:8000"
APP_BASE_URL="http://localhost:8000"
APP_BASE_PATH="/"

ADMIN_BASE_URL="http://localhost:8000"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:8000"
SPACE_BASE_PATH="/spaces"

LIVE_BASE_URL="http://localhost:8000"
LIVE_BASE_PATH="/live"
LIVE_SERVER_SECRET_KEY="plane-live-local-secret"

# Runtime
GUNICORN_WORKERS=2
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT="60/minute"
